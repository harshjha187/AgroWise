# Copy this file to .env (which is gitignored) and fill in real values
# before running `docker compose up`. Never commit the real .env.

# Required. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGROWISE_API_KEY=

# Optional. Comma-separated list of origins allowed to call the API
# cross-origin (only needed if a frontend is hosted somewhere other than
# this same domain). Leave blank for same-origin only.
AGROWISE_ALLOWED_ORIGINS=
